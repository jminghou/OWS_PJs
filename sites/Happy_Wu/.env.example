# Happy_Wu — 環境變數
# cp .env.example .env 後填入實際值；正式環境在 Railway Dashboard → Variables 設定同名變數

FLASK_CONFIG=development
FLASK_PORT=5010

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ows_happy_wu
REDIS_URL=redis://localhost:6379/2
CORS_ORIGINS=http://localhost:3010

# 平台資料表的 schema 佈局：與 Polaris 相同的 blog / shop 分流。見 docs/MIGRATIONS.md
OWS_BLOG_SCHEMA=blog
OWS_SHOP_SCHEMA=shop

# 身分模型：本站用自己的 users 表（不依賴任何外部身分系統）
OWS_IDENTITY_MODE=local

# 會員系統（core 的 /api/v1/auth/member/*）：本站啟用
MEMBER_AUTH_ENABLED=true

# 電商模組（商品／訂單／付款；packages/commerce）：本站啟用。
# 需多跑一條 migration 鏈：db upgrade -d packages/commerce/migrations（在 core 鏈之後、站台鏈之前）
COMMERCE_ENABLED=true

# Studio 內容工作區（packages/studio）：本站啟用。需多跑 db upgrade -d packages/studio/migrations（在 commerce 鏈之後、站台鏈之前）
STUDIO_ENABLED=true

# 後台儲存首頁設定後回呼前端清 ISR 快取；與前端 .env.local 的 REVALIDATE_SECRET 相同
# FRONTEND_REVALIDATE_URL=https://www.example.com/api/revalidate
REVALIDATE_SECRET=change-me

# 正式環境（FLASK_CONFIG=production）另需：
# JWT_COOKIE_DOMAIN=.example.com
