{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "ES2017"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ows/ui": [
        "../../../packages/ui/src/index.ts"
      ],
      "@ows/ui/*": [
        "../../../packages/ui/src/*"
      ],
      "@ows/ziwei-chart": [
        "../../../packages/ziwei-chart/src/index.ts"
      ],
      "@ows/ziwei-chart/core": [
        "../../../packages/ziwei-chart/src/core/index.ts"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
