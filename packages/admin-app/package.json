{
  "name": "@ows/admin-app",
  "version": "0.1.0",
  "private": true,
  "description": "OWS 後台管理介面 —— 整套頁面元件，站台以一行 re-export 掛載",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pages/*": "./src/pages/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
