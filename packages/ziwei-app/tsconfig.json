{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@ows/ui": ["../ui/src/index.ts"],
      "@ows/ui/*": ["../ui/src/*"],
      "@ows/platform-api": ["../platform-api/src/index.ts"],
      "@ows/platform-api/*": ["../platform-api/src/*"],
      "@ows/ziwei-chart": ["../ziwei-chart/src/index.ts"],
      "@ows/ziwei-chart/core": ["../ziwei-chart/src/core/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
