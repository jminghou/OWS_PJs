{
  "name": "@ows/newsletter",
  "version": "0.1.0",
  "private": true,
  "description": "Newsletter（選用）：電子報訂閱名單 —— 公開訂閱表單、確認／退訂流程、後台訂閱者列表與 CSV 匯出的頁面與 API client。後端見同目錄的 Python 套件",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./pages/*": "./src/pages/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./*": "./src/*"
  },
  "scripts": { "typecheck": "tsc --noEmit -p tsconfig.json" },
  "peerDependencies": { "next": "^15.0.0", "react": "^18.0.0", "react-dom": "^18.0.0" },
  "devDependencies": { "typescript": "^5" }
}
